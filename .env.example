NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for administrator invitations and account-activity list.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ChatGPT task analysis uses the user's existing ChatGPT session through
# copy/open/paste-back. It does not need an API key or Vercel AI Gateway.

# Google Calendar OAuth. Never prefix these values with NEXT_PUBLIC_.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
# 32-byte base64 or 64-character hexadecimal key.
GOOGLE_TOKEN_ENCRYPTION_KEY=
WORK_GOOGLE_ACCOUNT_EMAIL=info@wecarenursing.com.hk
# Optional: seeds Suki's support profile on first account bootstrap.
SUKI_LOGIN_EMAIL=

# Daily three-day due digest.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Derek Control Panel <info@wecarenursing.com.hk>
